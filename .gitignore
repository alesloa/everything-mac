# Build artifacts
.build/
DerivedData/
App/build/
App/EverythingMac.app

# XcodeGen output (regenerated from App/project.yml by scripts/build-dev.sh)
*.xcodeproj
*.xcworkspace
.swiftpm/

# Local test suites (individual regression files can be tracked explicitly).
# Package.swift wires the test target only when the directory is present.
Tests/*
!Tests/IndexCoreTests/
Tests/IndexCoreTests/*
!Tests/IndexCoreTests/NetworkShareTests.swift
!Tests/IndexCoreTests/FuzzySearchTests.swift
!Tests/IndexCoreTests/UniqueNameIndexTests.swift
!Tests/AppIntegrationTests/

# macOS, logs, crash dumps
.DS_Store
*.log
*.crash

# Internal design/planning notes (not needed to build or use the app)
docs/
